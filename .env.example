# Copy to .env for real runs. The mock pipeline needs none of these.

# Credit guard. Modal free credit is $30 per month; the guard refuses a run
# whose estimate would land inside the safety margin.
TURBINE_BUDGET_CAP_USD=30.00
TURBINE_SAFETY_MARGIN_USD=5.00

# OpenAI-compatible endpoint for measured runs, typically `vllm serve`
# behind a Modal proxy. Empty means mock-only.
TURBINE_BASE_URL=
TURBINE_MODEL=
TURBINE_API_KEY=
